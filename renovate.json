{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "timezone": "Europe/London",
  "dependencyDashboard": true,
  "gitAuthor": "D's Renovate Bot <renovate@thehome.party>",
  "assignees": ["DavBax"],
  "labels": ["renovate"],
  "prConcurrentLimit": 5,

  "packageRules": [
     {
     "description": "GitHub Actions versions in workflow files - review before merging",
     "matchManagers": ["github-actions"],
     "automerge": false
     },
     {
       "description": "Group all services within the same compose file into one PR",
       "matchManagers": ["docker-compose"],
       "groupName": "{{parentDir}}"
     },
     {
       "description": "Automerge patch bumps once CI passes",
       "matchManagers": ["docker-compose"],
       "matchUpdateTypes": ["patch"],
       "automerge": true,
       "automergeType": "pr",
       "platformAutomerge": true,
       "labels": ["patch-update", "auto-merge"]
     },
     {
       "description": "Review minor bumps once CI passes",
       "matchManagers": ["docker-compose"],
       "matchUpdateTypes": ["minor"],
       "automerge": false,
       "labels": ["minor-update", "needs-review"]
     },
     {
       "description": "Major bumps always need manual review",
       "matchManagers": ["docker-compose"],
       "matchUpdateTypes": ["major"],
       "automerge": false,
       "labels": ["major-update", "needs-review"]
     },
     {
       "description": "Stacks still on 'latest': digest-only tracking, always reviewed",
       "matchManagers": ["docker-compose"],
       "matchUpdateTypes": ["digest"],
       "automerge": false,
       "labels": ["latest-tag-tracking"]
     }
  ]
}
